PORT=3100
JSON_BODY_LIMIT_MB=5
OUTPUT_DIR=output

# Scheduler
SCHEDULER_ENABLED=true
DAILY_CRON=0 6 * * *

# Email settings (if omitted, app runs in dry-run mode and writes output files locally)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=po-status@company.com

# Optional: Timezone for report display labels
REPORT_TIMEZONE=UTC
